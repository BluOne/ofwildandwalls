<% const isEdit=mode==="edit" ; %>
  <%- include("partials/head", { pageTitle: (isEdit ? "Edit photo" : "Add photo" ) + " · OF Wild & Walls" }) %>
    <div class="flex min-h-screen flex-col">
      <%- include("partials/header", { flash: "" , primaryForm: "photo-form" }) %>

        <div class="grid flex-1 items-stretch" style="grid-template-columns: 214px 1fr">
          <%- include("partials/sidebar", { nav: nav, photos: [], categories: categories }) %>

            <main class="min-w-0 px-7 pb-11 pt-6">
              <form id="photo-form" method="post" enctype="multipart/form-data"
                action="<%= isEdit ? '/admin/photos/' + (typeof originalSlug !== 'undefined' && originalSlug ? originalSlug : photo.slug) : '/admin/photos' %>">
                <% if (typeof returnPage !=="undefined" && returnPage) { %>
                  <input type="hidden" name="page" value="<%= returnPage %>">
                  <% } %>
                    <% if (typeof returnSearch !=="undefined" && returnSearch) { %>
                      <input type="hidden" name="search" value="<%= returnSearch %>">
                      <% } %>
                        <% if (typeof error !=="undefined" && error) { %>
                          <div
                            class="mb-4 flex items-center justify-between gap-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13px] font-medium text-red-700">
                            <span>&#9888; <%= error %></span>
                            <button type="button" onclick="this.parentElement.remove()"
                              class="text-red-500 hover:text-red-800">&times;</button>
                          </div>
                          <% } %>
                            <div class="mb-4 flex items-end justify-between gap-4">
                              <div>
                                <h1 class="m-0 mb-1 text-[21px] font-semibold tracking-tight">
                                  <%= isEdit ? "Edit photo" : "Add photo" %>
                                </h1>
                                <p class="m-0 text-[13px] text-mute">
                                  <%= isEdit ? "/" + photo.slug
                                    : "Upload the file, then describe it. Extra fields are yours to invent." %>
                                </p>
                              </div>
                              <div class="flex gap-2">
                                <a href="/admin/photos<%= (typeof returnPage !== 'undefined' && returnPage) ? '?page='
                                  + returnPage + (typeof returnSearch !== 'undefined' && returnSearch ? '&search=' +
                                  encodeURIComponent(returnSearch) : '' ) : '' %>" class="pill-light">Cancel</a>
                                <button type="submit" name="live" value="draft" class="pill-light">Save as
                                  draft</button>
                                <button type="submit" name="live" value="live" class="pill-dark">
                                  <%= isEdit ? "Save changes" : "Save & Publish" %>
                                </button>
                              </div>
                            </div>

                            <div class="grid items-start gap-4"
                              style="grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr)">

                              <div class="grid gap-4">
                                <section class="card p-5">
                                  <div class="kicker mb-3.5">Core details</div>
                                  <div class="grid grid-cols-2 gap-3.5">
                                    <label class="label">Panel title <span class="text-red-500">*</span>
                                      <input class="field mt-1.5" name="title" value="<%= photo.title %>"
                                        placeholder="Ridgeline, Noon" required>
                                    </label>
                                    <label class="label">Slug <span class="text-red-500">*</span>
                                      <input class="field mt-1.5" id="slug-input" name="slug" value="<%= photo.slug %>"
                                        placeholder="morning-patrol" autocomplete="off" spellcheck="false" required>
                                      <%# "1" while the slug follows the panel title automatically, "0" once it has been
                                        typed by hand. An existing photo starts at "0" so editing its panel title never
                                        silently changes its page address. %>
                                        <input type="hidden" id="slug-auto" name="slug_auto"
                                          value="<%= typeof slugAuto !== 'undefined' ? slugAuto : ((!isEdit && !photo.slug) ? '1' : '0') %>">
                                        <span id="slug-hint"
                                          class="mt-1 block text-[11px] font-normal text-mute"></span>
                                    </label>
                                    <label class="label">
                                      <div class="flex items-center justify-between">
                                        <span>
                                          Hover caption
                                        </span>
                                      </div>

                                      <input class="field mt-1.5" name="cap" value="<%= photo.cap %>"
                                        placeholder="Morning Patrol">
                                    </label>
                                    <%- include("partials/photo-details-fields", { photo: photo }) %>
                                  </div>
                                </section>
                              </div>

                              <div class="grid gap-4">
                                <section class="card p-5">
                                  <div class="kicker mb-3.5">File <span class="text-red-500">*</span></div>
                                  <div id="image-preview-container"
                                    class="<%= photo.src ? '' : 'hidden' %> mb-3 aspect-[3/2] w-full overflow-hidden rounded-2xl bg-[#e6e0d7]">
                                    <img id="image-preview" src="<%= photo.src || '' %>" alt="<%= photo.alt || '' %>"
                                      class="block h-full w-full object-cover">
                                  </div>

                                  <div id="drop-zone"
                                    class="rounded-2xl border-2 border-dashed border-[#d4cabb] bg-sand px-5 py-7 text-center transition-colors hover:border-amber hover:bg-amber/5 cursor-pointer">
                                    <div class="mb-1.5 text-sm font-semibold" id="drop-zone-text">
                                      <%= photo.src ? 'Drop new JPEG or click replace' : 'Drop a JPEG here' %>
                                    </div>
                                    <div class="mb-3.5 text-xs text-mute" id="drop-zone-subtext">Saved to S3 Bucket ·
                                      4000px longest edge</div>
                                    <label
                                      class="inline-block cursor-pointer rounded-full bg-pine px-4 py-2.5 text-xs text-cream hover:bg-[#1a382c]">
                                      <span id="choose-file-btn-text">
                                        <%= photo.src ? 'Replace file' : 'Choose file' %>
                                      </span>
                                      <input type="file" id="photo-file-input" name="photo"
                                        accept="image/jpeg,image/png,image/webp" class="hidden">
                                    </label>
                                  </div>
                                  <p id="photo-file-error" class="mt-2 hidden text-[12px] font-medium text-red-600"
                                    role="alert">Choose an image for this photo.</p>

                                  <input type="hidden" name="src" value="<%= photo.src %>">
                                  <label class="label mt-3.5">Alt text
                                    <input class="field mt-1.5" name="alt" value="<%= photo.alt %>"
                                      placeholder="Tiger walking">
                                  </label>
                                </section>
                              </div>
                            </div>
              </form>
            </main>
        </div>
    </div>

    <script>
      (function () {
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('photo-file-input');
        const previewContainer = document.getElementById('image-preview-container');
        const previewImg = document.getElementById('image-preview');
        const dropText = document.getElementById('drop-zone-text');
        const btnText = document.getElementById('choose-file-btn-text');

        if (!dropZone || !fileInput) return;

        function handleFile(file) {
          if (!file || !file.type.startsWith('image/')) return;
          const objectUrl = URL.createObjectURL(file);
          if (previewImg) previewImg.src = objectUrl;
          if (previewContainer) previewContainer.classList.remove('hidden');
          if (dropText) dropText.textContent = 'Selected: ' + file.name;
          if (btnText) btnText.textContent = 'Change file';
        }

        fileInput.addEventListener('change', function (e) {
          if (e.target.files && e.target.files[0]) {
            handleFile(e.target.files[0]);
          }
        });

        ['dragenter', 'dragover'].forEach(eventName => {
          dropZone.addEventListener(eventName, function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.add('border-amber', 'bg-amber/10');
          }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
          dropZone.addEventListener(eventName, function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('border-amber', 'bg-amber/10');
          }, false);
        });

        dropZone.addEventListener('drop', function (e) {
          const dt = e.dataTransfer;
          const files = dt.files;
          if (files && files.length > 0) {
            fileInput.files = files;
            handleFile(files[0]);
          }
        });
      })();
    </script>


    <script>
      (function () {
        const slugInput = document.getElementById('slug-input');
        const autoInput = document.getElementById('slug-auto');
        const hint = document.getElementById('slug-hint');
        const titleInput = document.querySelector('input[name="title"]');
        const fileInput = document.getElementById('photo-file-input');
        const dropZone = document.getElementById('drop-zone');

        if (!slugInput || !autoInput) return;

        // The file input is hidden behind the drop zone, and a browser can't
        // point its "required" bubble at a hidden field — so the image is
        // checked here instead, alongside the browser's own check of the rest.
        const form = document.getElementById('photo-form');
        const existingSrc = document.querySelector('input[name="src"]');
        const fileError = document.getElementById('photo-file-error');

        function hasImage() {
          return (fileInput && fileInput.files && fileInput.files.length > 0) ||
            (existingSrc && existingSrc.value);
        }

        function showFileError(show) {
          fileError.classList.toggle('hidden', !show);
          dropZone.classList.toggle('border-red-400', show);
          dropZone.classList.toggle('border-[#d4cabb]', !show);
        }

        form.querySelectorAll('button[type="submit"]').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            if (hasImage()) return;
            e.preventDefault();
            showFileError(true);
            // Still flag any other empty required field, then bring the image
            // message into view if the other fields are all filled in.
            if (form.reportValidity()) dropZone.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });

        if (fileInput) fileInput.addEventListener('change', function () { if (hasImage()) showFileError(false); });
        if (dropZone) dropZone.addEventListener('drop', function () { if (hasImage()) showFileError(false); });

        // Must match slugify() in src/controllers/photoController.ts.
        function slugify(s) {
          return String(s || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        }

        function source() {
          return (titleInput && titleInput.value) || '';
        }

        function isAuto() {
          return autoInput.value === '1';
        }

        function render() {
          if (isAuto()) {
            slugInput.value = slugify(source());
            hint.textContent = 'Filled in from the panel title. Type here to set your own.';
          } else {
            hint.textContent = 'Set by hand. Clear it to fill it in from the panel title again.';
          }
        }

        // While typing, an emptied field only switches back to automatic —
        // it refills on blur, so clearing it to retype isn't fought mid-edit.
        slugInput.addEventListener('input', function () {
          autoInput.value = slugInput.value.trim() === '' ? '1' : '0';
          hint.textContent = isAuto()
            ? 'Will fill in from the panel title.'
            : 'Set by hand. Clear it to fill it in from the panel title again.';
        });

        slugInput.addEventListener('blur', function () {
          if (isAuto()) {
            render();
          } else {
            slugInput.value = slugify(slugInput.value);
            if (!slugInput.value) {
              autoInput.value = '1';
              render();
            }
          }
        });

        if (titleInput) {
          titleInput.addEventListener('input', function () { if (isAuto()) render(); });
        }

        // Deliberately not tied to the image: uploading or dropping a file
        // must never change the slug, only the panel title does.
        render();
      })();
    </script>

    <%- include("partials/footer") %>