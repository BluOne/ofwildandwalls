<%# Add/Edit photo fields from Caption through Tags, as cells of the caller's 2-column grid.
  Expects photo, categories, collections, cameras, lenses, countries. %>
<label class="label">Caption
  <input class="field mt-1.5" name="ref" value="<%= photo.ref %>" placeholder="">
</label>
<%
  // A searchable multi-select of existing values (chips for the ticked ones).
  // `name` is the posted field; ticked items are listed first.
  function multiPicker(label, name, list, selected) {
    var sel = selected.map(Number);
    var sorted = list.slice().sort(function (x, y) {
      return (sel.indexOf(Number(y.id)) !== -1) - (sel.indexOf(Number(x.id)) !== -1);
    });
%>
<div class="label" data-multi-picker>
  <div class="flex items-center justify-between">
    <span><%= label %></span>
    <span class="text-[11px]" data-pick-count></span>
  </div>
  <div class="mt-1.5 flex flex-wrap gap-1.5 empty:hidden" data-pick-chips></div>
  <div class="mt-1.5 rounded-xl border border-line2 bg-white">
    <input type="search" class="w-full rounded-t-xl border-b border-line2 bg-transparent px-3.5 py-2 text-[13px] text-ink outline-none"
      placeholder="Search <%= label.toLowerCase() %>..." data-pick-search autocomplete="off">
    <div class="max-h-48 space-y-0.5 overflow-y-auto p-1.5">
      <% sorted.forEach(function (item) { %>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 text-[13px] text-ink hover:bg-sand" data-pick-item>
          <input type="checkbox" name="<%= name %>" value="<%= item.id %>"
            <%= sel.indexOf(Number(item.id)) !== -1 ? "checked" : "" %>>
          <span data-pick-name><%= item.title || item.name %></span>
        </label>
      <% }); %>
      <p class="hidden px-2 py-1.5 text-[12px] text-mute" data-pick-empty>No <%= label.toLowerCase() %> match.</p>
    </div>
  </div>
</div>
<% } %>
<label class="label">Category
  <select class="field mt-1.5" name="category_id">
    <option value="">Select category</option>
    <% var selCat = Number((photo.category_ids && photo.category_ids[0]) || photo.category_id); %>
    <% categories.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= selCat === Number(c.id) ? "selected" : "" %>><%= c.title %></option>
    <% }); %>
  </select>
</label>
<% multiPicker("Collections", "collection_ids", (typeof collections !== "undefined" ? collections : []),
     photo.collection_ids || (photo.collection_id ? [photo.collection_id] : [])); %>
<label class="label">Camera
  <select class="field mt-1.5" name="camera_id">
    <option value="">Select camera</option>
    <% (typeof cameras !=="undefined" ? cameras : []).forEach(function (cam) { const
      camName=cam.brand ? (cam.brand + ' ' + cam.model) : cam.model; %>
      <option value="<%= cam.id %>" <%=Number(photo.camera_id)===Number(cam.id)
        ? "selected" : "" %>><%= camName %>
      </option>
      <% }); %>
  </select>
</label>
<label class="label">Lens
  <select class="field mt-1.5" name="lens_id">
    <option value="">Select lens</option>
    <% (typeof lenses !=="undefined" ? lenses : []).forEach(function (l) { const
      lensName=l.brand ? (l.brand + ' ' + l.model) : l.model; %>
      <option value="<%= l.id %>" <%=Number(photo.lens_id)===Number(l.id)
        ? "selected" : "" %>><%= lensName %>
      </option>
      <% }); %>
  </select>
</label>
<label class="label">Date
  <%# Typed or pasted as dd/mm/yyyy; the hidden field posts yyyy-mm-dd as before. %>
  <input id="date-input" class="field mt-1.5" type="text" inputmode="numeric" autocomplete="off"
    placeholder="dd/mm/yyyy">
  <input type="hidden" id="date-hidden" name="date" value="<%= photo.date || '' %>">
  <script>
    (function () {
      const shown = document.getElementById('date-input');
      const hidden = document.getElementById('date-hidden');
      if (!shown || !hidden) return;

      // 25/04/2026, 25-4-26, 25.04.2026 or 2026-04-25 → "2026-04-25"; '' if not a real date.
      function toIso(raw) {
        const v = String(raw || '').trim();
        let y, mo, d, m;
        if ((m = v.match(/^(\d{4})[\/.-](\d{1,2})[\/.-](\d{1,2})$/))) { y = +m[1]; mo = +m[2]; d = +m[3]; }
        else if ((m = v.match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{2}|\d{4})$/))) {
          d = +m[1]; mo = +m[2]; y = m[3].length === 2 ? 2000 + +m[3] : +m[3];
        } else return '';
        const dt = new Date(Date.UTC(y, mo - 1, d));
        if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) return '';
        return y + '-' + String(mo).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      }
      const toShown = iso => iso ? iso.slice(8, 10) + '/' + iso.slice(5, 7) + '/' + iso.slice(0, 4) : '';

      function sync() {
        const text = shown.value.trim();
        const iso = toIso(text);
        hidden.value = iso;
        shown.setCustomValidity(text && !iso ? 'Enter a real date as dd/mm/yyyy.' : '');
      }

      // Existing value (also older dd/mm/yy ones) shown as dd/mm/yyyy.
      const saved = hidden.value.trim();
      shown.value = toShown(toIso(saved)) || saved;
      sync();

      shown.addEventListener('input', sync);
      shown.addEventListener('blur', function () {
        if (hidden.value) shown.value = toShown(hidden.value);
      });
    })();
  </script>
</label>
<%# Location is picked most-specific first: a city fills in its state and
    country, a state fills in its country. Cities exist for India and the US. %>
<%# City and State are search-as-you-type dropdowns (styled like the
    Collections picker); the script at the bottom wires them up. %>
<div class="label">
  <label for="city-input">City</label>
  <div class="relative mt-1.5" data-combo>
    <input id="city-input" class="field pr-9" autocomplete="off" spellcheck="false"
      role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="city-options"
      placeholder="Search city — e.g. Kanha, San Francisco">
    <button type="button" data-combo-clear aria-label="Clear city"
      class="absolute right-2 top-1/2 hidden h-6 w-6 -translate-y-1/2 rounded-full text-[15px] leading-none text-mute hover:bg-sand hover:text-ink">&times;</button>
    <div id="city-options" role="listbox" data-combo-list
      class="absolute inset-x-0 top-full z-30 mt-1 hidden max-h-64 overflow-y-auto rounded-xl border border-line2 bg-white p-1.5 shadow-[0_12px_32px_rgba(0,0,0,0.12)]"></div>
  </div>
  <span class="mt-1 block text-[11px] font-normal normal-case tracking-normal text-mute">Optional. Leave empty for the whole state.</span>
  <%# The saved location: the city's row if one is picked, else the state's. %>
  <input type="hidden" id="country-id-hidden" name="country_id" value="<%= photo.country_id || '' %>">
</div>
<div class="label">
  <label for="state-input">State / Region</label>
  <div class="relative mt-1.5" data-combo>
    <input id="state-input" class="field pr-9" autocomplete="off" spellcheck="false"
      role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="state-options"
      placeholder="Search state — e.g. Madhya Pradesh">
    <button type="button" data-combo-clear aria-label="Clear state"
      class="absolute right-2 top-1/2 hidden h-6 w-6 -translate-y-1/2 rounded-full text-[15px] leading-none text-mute hover:bg-sand hover:text-ink">&times;</button>
    <div id="state-options" role="listbox" data-combo-list
      class="absolute inset-x-0 top-full z-30 mt-1 hidden max-h-64 overflow-y-auto rounded-xl border border-line2 bg-white p-1.5 shadow-[0_12px_32px_rgba(0,0,0,0.12)]"></div>
  </div>
  <input type="hidden" id="state-hidden" name="state"
    value="<%= photo.state || '' %>">
</div>
<label class="label">Country
  <select id="country-select" class="field mt-1.5">
    <option value="">Select country</option>
  </select>
</label>
<label class="label col-span-2">Settings (Field Data)
  <input class="field mt-1.5" name="settings" value="<%= photo.settings || '' %>"
    placeholder="1/125 · f/11 · ISO 100">
</label>
<label class="label col-span-2">About the photo
  <textarea class="field mt-1.5 resize-y" name="about" rows="3"
    placeholder="One or two lines about the moment."><%= photo.about %></textarea>
</label>
<%# Tags are hidden from the form (the site shows collections instead); a
    photo's existing tags are kept as they are when it's saved. %>
<input type="hidden" name="tags" value="<%= photo.tags || '' %>">
<%# The old free-text Location ("Kanha", "Ranthambore") is no longer edited
    here, but it names the place in the site's Location filter for photos
    without a City, so a photo keeps it when saved. %>
<input type="hidden" name="location" value="<%= photo.location || '' %>">
<script>
  document.querySelectorAll('[data-multi-picker]').forEach(function (root) {
    const search = root.querySelector('[data-pick-search]');
    const chips = root.querySelector('[data-pick-chips]');
    const count = root.querySelector('[data-pick-count]');
    const empty = root.querySelector('[data-pick-empty]');
    const items = Array.from(root.querySelectorAll('[data-pick-item]'));

    function renderChips() {
      chips.innerHTML = '';
      let n = 0;
      items.forEach(function (item) {
        const box = item.querySelector('input');
        if (!box.checked) return;
        n++;
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'inline-flex items-center gap-1 rounded-full bg-pine px-2.5 py-1 text-[11px] text-cream hover:bg-pine2';
        chip.textContent = item.querySelector('[data-pick-name]').textContent.trim();
        chip.title = 'Remove';
        const x = document.createElement('span');
        x.textContent = '×';
        x.className = 'text-[13px] leading-none opacity-70';
        chip.appendChild(x);
        chip.addEventListener('click', function () { box.checked = false; renderChips(); });
        chips.appendChild(chip);
      });
      count.textContent = n ? n + ' selected' : '';
    }

    function filter() {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      items.forEach(function (item) {
        const match = !q || item.querySelector('[data-pick-name]').textContent.toLowerCase().includes(q);
        item.classList.toggle('hidden', !match);
        if (match) shown++;
      });
      empty.classList.toggle('hidden', shown > 0);
    }

    items.forEach(function (item) { item.querySelector('input').addEventListener('change', renderChips); });
    search.addEventListener('input', filter);
    // Enter in the search box shouldn't submit the photo form.
    search.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });
    renderChips();
  });
</script>

<div id="country-data" style="display:none;"
  data-countries="<%= JSON.stringify(typeof countries !== 'undefined' ? countries : []) %>"
  data-selected="<%= photo.country_id || '' %>"></div>
<script>
  (function () {
    const dataEl = document.getElementById('country-data');
    const countries = dataEl && dataEl.getAttribute('data-countries') ? JSON.parse(dataEl.getAttribute('data-countries')) : [];
    const selectedAttr = dataEl ? dataEl.getAttribute('data-selected') : '';
    const selectedCountryId = selectedAttr ? Number(selectedAttr) : null;
    const cityInput = document.getElementById('city-input');
    const stateInput = document.getElementById('state-input');
    const countrySelect = document.getElementById('country-select');
    const stateHidden = document.getElementById('state-hidden');
    const idHidden = document.getElementById('country-id-hidden');

    if (!cityInput || !stateInput || !countrySelect || !stateHidden || !idHidden) return;

    // Rows: city set → a city; state set, no city → the whole state;
    // neither → the whole country (a few small countries have no states).
    const cityRows = countries.filter(c => c.city);
    const stateRows = countries.filter(c => !c.city && c.state);
    const countryRows = countries.filter(c => !c.city && !c.state);

    // The City box shows just the city; its state and country are in their
    // own fields. The State box keeps "State, Country" (state names repeat
    // across countries).
    const cityLabel = c => c.city;
    const cityFull = c => c.city + ', ' + c.state + ', ' + c.country;
    const stateLabel = c => c.state + ', ' + c.country;

    let city = null;   // picked city row
    let state = null;  // picked state row

    const names = [...new Set(countries.map(c => c.country))].sort();
    names.forEach(function (name) {
      const opt = document.createElement('option');
      opt.value = name;
      opt.textContent = name;
      countrySelect.appendChild(opt);
    });

    const esc = t => String(t).replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]);
    const MAX_SHOWN = 60;

    /*
     * Search-as-you-type dropdown on a text input. `rows()` gives the
     * current candidates; `primary`/`secondary` are the two lines of each
     * option; `label` is the text put in the box when one is picked.
     */
    function combo(input, opts) {
      const wrap = input.closest('[data-combo]');
      const list = wrap.querySelector('[data-combo-list]');
      const clearBtn = wrap.querySelector('[data-combo-clear]');
      let shown = [];
      let active = -1;

      function close() {
        list.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        active = -1;
      }

      function highlight(i) {
        const items = list.querySelectorAll('[data-i]');
        items.forEach(el => el.classList.toggle('bg-cream', Number(el.dataset.i) === i));
        active = i;
        const el = list.querySelector('[data-i="' + i + '"]');
        if (el) el.scrollIntoView({ block: 'nearest' });
      }

      function render() {
        const q = input.value.trim().toLowerCase();
        const all = opts.rows();
        // Matches at the start of the name first, then anywhere in the label.
        const starts = [], contains = [];
        all.forEach(function (r) {
          const p = opts.primary(r).toLowerCase();
          if (!q || p.startsWith(q)) starts.push(r);
          else if ((opts.search || opts.label)(r).toLowerCase().includes(q)) contains.push(r);
        });
        const matches = starts.concat(contains);
        shown = matches.slice(0, MAX_SHOWN);

        if (!all.length) {
          list.innerHTML = '<p class="px-2.5 py-2 text-[12px] text-mute">' + esc(opts.emptyAll) + '</p>';
        } else if (!shown.length) {
          list.innerHTML = '<p class="px-2.5 py-2 text-[12px] text-mute">No match for “' + esc(input.value.trim()) + '”.</p>';
        } else {
          list.innerHTML = shown.map(function (r, i) {
            const picked = opts.current() === r;
            return '<div role="option" data-i="' + i + '" aria-selected="' + picked + '"' +
              ' class="flex cursor-pointer items-baseline justify-between gap-3 rounded-lg px-2.5 py-2 text-[13px] hover:bg-cream">' +
              '<span class="truncate ' + (picked ? 'font-semibold text-pine' : 'text-ink') + '">' + esc(opts.primary(r)) + '</span>' +
              '<span class="shrink-0 truncate text-[11px] text-mute">' + esc(opts.secondary(r)) + '</span>' +
              '</div>';
          }).join('') +
          (matches.length > shown.length
            ? '<p class="px-2.5 pb-1 pt-1.5 text-[11px] text-mute">' + (matches.length - shown.length) + ' more — keep typing to narrow down.</p>'
            : '');
        }
        list.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
        active = -1;
      }

      // A pick hands over the row itself (city names repeat across states,
      // so the text alone can't say which one was meant).
      function pick(r) {
        input.value = r ? opts.label(r) : '';
        clearBtn.classList.toggle('hidden', !input.value);
        opts.onPick(r);
        close();
      }

      input.addEventListener('focus', render);
      input.addEventListener('click', render);
      input.addEventListener('input', function () {
        clearBtn.classList.toggle('hidden', !input.value);
        opts.onType(input.value.trim());
        render();
      });
      input.addEventListener('keydown', function (e) {
        const open = !list.classList.contains('hidden');
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (!open) return render();
          if (!shown.length) return;
          const step = e.key === 'ArrowDown' ? 1 : -1;
          highlight((active + step + shown.length) % shown.length);
        } else if (e.key === 'Enter') {
          // Enter picks the highlighted (or only) option, never submits.
          if (open) {
            e.preventDefault();
            const r = shown[active] || (shown.length === 1 ? shown[0] : null);
            if (r) pick(r);
          }
        } else if (e.key === 'Escape') {
          if (open) { e.preventDefault(); close(); }
        } else if (e.key === 'Tab') {
          close();
        }
      });
      // mousedown, not click, so the input keeps focus until the pick lands.
      list.addEventListener('mousedown', function (e) {
        e.preventDefault();
        const el = e.target.closest('[data-i]');
        if (el) pick(shown[Number(el.dataset.i)]);
      });
      input.addEventListener('blur', close);
      clearBtn.addEventListener('mousedown', function (e) { e.preventDefault(); });
      clearBtn.addEventListener('click', function () {
        pick(null);
        input.focus();
      });

      return { refreshClear: () => clearBtn.classList.toggle('hidden', !input.value) };
    }

    // country_id = the city's row, else the state's, else a country-only row.
    function sync() {
      const countryRow = !state && countrySelect.value
        ? countryRows.find(c => c.country === countrySelect.value)
        : null;
      idHidden.value = city ? city.id : state ? state.id : countryRow ? countryRow.id : '';
      stateHidden.value = state ? state.state : '';
      cityInput.setCustomValidity(cityInput.value.trim() && !city ? 'Pick a city from the list, or leave it empty.' : '');
      stateInput.setCustomValidity(stateInput.value.trim() && !state ? 'Pick a state from the list.' : '');
      cityCombo.refreshClear();
      stateCombo.refreshClear();
    }

    function setState(row) {
      state = row;
      stateInput.value = row ? stateLabel(row) : '';
      if (row) countrySelect.value = row.country;
    }

    // Suggestions narrow to whatever is already chosen further down.
    const cityCombo_rows = () => cityRows.filter(c =>
      state ? c.country === state.country && c.state === state.state
            : !countrySelect.value || c.country === countrySelect.value);
    const cityCombo = combo(cityInput, {
      rows: cityCombo_rows,
      primary: c => c.city,
      secondary: c => c.state + ', ' + c.country,
      label: cityLabel,
      search: cityFull,
      current: () => city,
      emptyAll: 'No cities for this state yet — leave City empty.',
      onPick: pickCity,
      // Typed text counts only when it names exactly one city in the list.
      onType: function (text) {
        const t = text.toLowerCase();
        const hits = t ? cityCombo_rows().filter(c => c.city.toLowerCase() === t) : [];
        if (city && hits.indexOf(city) !== -1) return sync();
        if (hits.length === 1) return pickCity(hits[0]);
        city = null;
        sync();
      },
    });

    const stateCombo = combo(stateInput, {
      rows: () => stateRows.filter(c => !countrySelect.value || c.country === countrySelect.value),
      primary: c => c.state,
      secondary: c => c.country,
      label: stateLabel,
      current: () => state,
      emptyAll: 'No states for this country.',
      onPick: pickState,
      onType: function (text) {
        pickState(stateRows.find(s => stateLabel(s) === text) || null, true);
      },
    });

    // A city brings its state and country with it.
    function pickCity(row) {
      city = row;
      if (row) {
        setState(stateRows.find(s => s.country === row.country && s.state === row.state) || null);
      }
      sync();
    }

    function pickState(row, typed) {
      state = row;
      if (row) countrySelect.value = row.country;
      if (!typed) stateInput.value = row ? stateLabel(row) : '';
      // A city outside the chosen state no longer fits.
      if (city && (!state || city.state !== state.state || city.country !== state.country)) {
        city = null;
        cityInput.value = '';
      }
      sync();
    }

    countrySelect.addEventListener('change', function () {
      if (state && state.country !== countrySelect.value) {
        setState(null);
        city = null;
        cityInput.value = '';
      }
      sync();
    });

    // Editing: fill in the saved location.
    const saved = selectedCountryId ? countries.find(c => Number(c.id) === selectedCountryId) : null;
    if (saved) {
      if (saved.city) {
        city = saved;
        cityInput.value = cityLabel(saved);
        setState(stateRows.find(s => s.country === saved.country && s.state === saved.state) || null);
      } else if (saved.state) {
        setState(saved);
      }
      countrySelect.value = saved.country;
    }
    sync();
  })();
</script>
