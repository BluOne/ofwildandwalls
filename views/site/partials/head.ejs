<%# views/partials/head.ejs %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Of Wild &amp; Walls' %></title>
  <% if (typeof imageOrigin !== "undefined" && imageOrigin) { %><link rel="preconnect" href="<%= imageOrigin %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=Inter+Tight:wght@500&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: { extend: {
        fontFamily: {
          sans:  ['Archivo', 'system-ui', 'sans-serif'],
          serif: ['"Playfair Display"', 'Georgia', 'serif'],
          tight: ['"Inter Tight"', 'system-ui', 'sans-serif'],
        },
        colors: { paper: '#ffffff', ink: '#141414', night: '#0d0d0d', nightpill: '#1b1b1b' },
      } },
    };
  </script>
  <style>
    /* `vw` units include the scrollbar's own width on platforms with a reserved
       (non-overlay) scrollbar, so any fixed/absolute element sized or centered
       with vw (the mobile nav/filter panels, masonry hover captions, Flow's
       column positions) can end up a few px wider than the actually-visible
       viewport. That's harmless internally, but left unchecked it makes the
       whole page horizontally scrollable on mobile/tablet just to reveal that
       sliver — clip it here instead. Doesn't affect #gridStrip's own intentional
       horizontal scroll, which is a separate nested overflow-x:auto container. */
    html, body { overflow-x: hidden; }
    /* Flow scrolls vertically, Grid fits one screen — without this, the
       scrollbar appearing/disappearing on a Flow <-> Grid switch changes
       the page width and jolts the header and photos sideways. */
    html { scrollbar-gutter: stable; }
    html { -webkit-font-smoothing: antialiased; }
    ::selection { background: #141414; color: #fff; }
    :focus-visible { outline: 2px solid #141414; outline-offset: 3px; }
    .dark :focus-visible { outline-color: #fff; }
    .no-bar { scrollbar-width: none; -ms-overflow-style: none; }
    .no-bar::-webkit-scrollbar { display: none; }
    @keyframes railIn { from { opacity: 0; transform: translateX(-26px); } to { opacity: 1; transform: none; } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    .rail-in  { animation: railIn .6s cubic-bezier(.2,.7,.2,1) both; }
    .fade-up  { animation: fadeUp .7s cubic-bezier(.2,.7,.2,1) both; }

    /* Flow view (#flowCanvas) has no layout CSS of its own: app.js
       scatters the photos across a sparse column grid and positions each
       .photo-item absolutely (see layoutFlow). Before app.js runs, photos
       just stack full-width in document order — the no-JS fallback.
       With JS on, the wall stays hidden until app.js has placed every
       photo (it adds .is-ready), so that stacked state never flashes. */
    .js #flowCanvas { opacity: 0; }
    .js #flowCanvas.is-ready { opacity: 1; transition: opacity .45s ease; }
    @media (prefers-reduced-motion: reduce) {
      .js #flowCanvas.is-ready { transition: none; }
    }

    /* Photos fade in once loaded (app.js adds .is-loaded); until then the
       tile shows the photo's dominant colour as its background. */
    .js .photo-img { opacity: 0; transition: opacity .4s ease; }
    .js .photo-img.is-loaded { opacity: 1; }
    @media (prefers-reduced-motion: reduce) {
      .js .photo-img { transition: none; }
    }

    /* Shared "+" cursor over photos — one element, moved by app.js with a
       transform once per frame. */
    .photo-plus-cursor {
      position: fixed; left: 0; top: 0; z-index: 30;
      width: 68px; height: 68px;
      display: grid; place-items: center;
      pointer-events: none;
      opacity: 0; transition: opacity .15s ease;
      will-change: transform;
      color: #fff;
    }
    .photo-plus-cursor.is-visible { opacity: 1; }
    /* Over a photo the "+" ring replaces the mouse pointer completely —
       including the hand on links and the zoom-in on the detail photo.
       Only for a real mouse; touch screens never show the ring. */
    @media (hover: hover) and (pointer: fine) {
      .js .photo-item, .js .photo-item * { cursor: none !important; }
    }
    .photo-plus-ring { position: absolute; inset: 0; width: 100%; height: 100%; }
    .photo-plus-icon { position: relative; width: 26px; height: 26px; }
  </style>
  <%# Apply saved theme immediately to prevent flash of wrong theme %>
  <script>
    (function(){
      document.documentElement.classList.add('js');
      var k = 'oww:theme';
      if (localStorage.getItem(k) === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body class="bg-paper text-ink dark:bg-night dark:text-white font-sans">
