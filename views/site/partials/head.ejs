<%# views/partials/head.ejs %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Of Wild &amp; Walls' %></title>
  <% if (typeof imageOrigin !== "undefined" && imageOrigin) { %><link rel="preconnect" href="<%= imageOrigin %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=Inter+Tight:wght@500&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: { extend: {
        fontFamily: {
          sans:  ['Archivo', 'system-ui', 'sans-serif'],
          serif: ['"Playfair Display"', 'Georgia', 'serif'],
          tight: ['"Inter Tight"', 'system-ui', 'sans-serif'],
        },
        colors: { paper: '#ffffff', ink: '#141414', night: '#0d0d0d', nightpill: '#1b1b1b' },
      } },
    };
  </script>
  <style>
    /* `vw` units include the scrollbar's own width on platforms with a reserved
       (non-overlay) scrollbar, so any fixed/absolute element sized or centered
       with vw (the mobile nav/filter panels, masonry hover captions, Flow's
       column positions) can end up a few px wider than the actually-visible
       viewport. That's harmless internally, but left unchecked it makes the
       whole page horizontally scrollable on mobile/tablet just to reveal that
       sliver — clip it here instead. Doesn't affect #gridStrip's own intentional
       horizontal scroll, which is a separate nested overflow-x:auto container. */
    html, body { overflow-x: hidden; }
    /* Flow scrolls vertically, Grid fits one screen — without this, the
       scrollbar appearing/disappearing on a Flow <-> Grid switch changes
       the page width and jolts the header and photos sideways. */
    html { scrollbar-gutter: stable; }
    html { -webkit-font-smoothing: antialiased; }
    ::selection { background: #141414; color: #fff; }
    :focus-visible { outline: 2px solid #141414; outline-offset: 3px; }
    .dark :focus-visible { outline-color: #fff; }
    .no-bar { scrollbar-width: none; -ms-overflow-style: none; }
    .no-bar::-webkit-scrollbar { display: none; }
    @keyframes railIn { from { opacity: 0; transform: translateX(-26px); } to { opacity: 1; transform: none; } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    .rail-in  { animation: railIn .6s cubic-bezier(.2,.7,.2,1) both; }
    .fade-up  { animation: fadeUp .7s cubic-bezier(.2,.7,.2,1) both; }

    /* ── Filter bar fold-back: from md up the filters are one row, but when
       active filters make it wider than the screen app.js adds .oww-compact
       and the row folds back into the "Filters" button + panel (phone style). ── */
    #filterBar.oww-compact #filtersToggle { display: flex !important; }
    #filterBar.oww-compact #filtersGroup.hidden { display: none !important; }
    #filterBar.oww-compact #filtersGroup:not(.hidden) {
      display: block !important; position: absolute !important;
      bottom: calc(100% + 12px) !important; left: 50% !important; transform: translateX(-50%) !important;
      width: calc(100vw - 2rem) !important; max-width: 300px !important;
      padding: .5rem !important; border-radius: 20px !important;
    }
    #filterBar.oww-compact #filtersGroup > div { margin-bottom: .25rem !important; }
    #filterBar.oww-compact #filtersGroup button[id$="Btn"] { width: 100% !important; }
    #filterBar.oww-compact .oww-type { display: inline !important; }
    #filterBar.oww-compact .oww-dropdown { bottom: calc(100% + 8px) !important; }

    /* ── Transparent header: only its controls take clicks, so the Flow wall
       underneath can still be dragged and its photos clicked through it. ── */
    .site-header { pointer-events: none; }
    .site-header a, .site-header button, .site-header #navPanel { pointer-events: auto; }

    /* Header controls sit on frosted chips so they stay readable over photos:
       round chips (Instagram, theme) and the Flow / Grid segmented toggle. */
    /* Soft fade from the page colour behind the header, so photos passing
       under it wash out (as in the design) instead of clashing with the logo. */
    .site-header::before {
      content: ""; position: absolute; inset: 0 0 -48px 0; z-index: -1; pointer-events: none;
      background: linear-gradient(to bottom, rgba(255,255,255,.92) 0%, rgba(255,255,255,.6) 55%, rgba(255,255,255,0) 100%);
    }
    .dark .site-header::before {
      background: linear-gradient(to bottom, rgba(13,13,13,.92) 0%, rgba(13,13,13,.6) 55%, rgba(13,13,13,0) 100%);
    }

    .hdr-chip, .hdr-seg {
      background: rgba(238,238,238,.88);
      -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    }
    .dark .hdr-chip, .dark .hdr-seg { background: rgba(38,38,38,.82); }
    .hdr-chip {
      display: flex; align-items: center; justify-content: center;
      width: 44px; height: 44px; border-radius: 9999px;
      color: rgba(20,20,20,.8); transition: color .2s, background-color .2s;
    }
    .hdr-chip:hover { color: #141414; background: rgba(228,228,228,.95); }
    .dark .hdr-chip { color: rgba(255,255,255,.8); }
    .dark .hdr-chip:hover { color: #fff; background: rgba(52,52,52,.92); }
    .hdr-seg { display: flex; align-items: center; gap: 2px; padding: 4px; border-radius: 9999px; }
    .hdr-seg-btn {
      height: 36px; padding: 0 18px; border-radius: 9999px;
      font-size: 15px; line-height: 36px; color: rgba(20,20,20,.6);
      transition: color .2s, background-color .2s, box-shadow .2s;
    }
    .hdr-seg-btn:hover { color: #141414; }
    /* Light: white pill on the grey track. Dark: near-black pill. */
    .hdr-seg-btn.is-active { background: #fff; color: #141414; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .dark .hdr-seg-btn { color: rgba(255,255,255,.62); }
    .dark .hdr-seg-btn:hover { color: #fff; }
    .dark .hdr-seg-btn.is-active { background: #0b0b0b; color: #fff; box-shadow: none; }

    /* ── Flow: endless drag canvas (#flowField). app.js lays photos out in one
       column width (native ratio, capped at 4:5 tall), shortest column first,
       repeating endlessly, and mounts only the tiles on screen. ── */
    :root { --flow-ph: rgba(20,20,20,.05); --flow-cap: rgba(20,20,20,.55); --flow-cap-on: #141414;
            --flow-amber: #F4B508; --flow-chip: rgba(255,255,255,.82); }
    .dark { --flow-ph: rgba(255,255,255,.06); --flow-cap: rgba(255,255,255,.55); --flow-cap-on: #fff;
            --flow-chip: rgba(13,13,13,.82); }
    #flowField { position: fixed; inset: 0; z-index: 0; overflow: hidden; touch-action: none;
                 user-select: none; -webkit-user-select: none; cursor: grab; outline: none; }
    #flowField.is-grabbing { cursor: grabbing; }
    #flowField.is-grabbing .flow-tile { pointer-events: none; }
    #flowView.hidden #flowField { display: none; }
    .flow-tile { position: absolute; left: 0; top: 0; display: block; will-change: transform;
                 text-decoration: none; color: inherit; transition: opacity .5s ease-out; }
    .flow-tile.is-new { animation: flowIn .7s cubic-bezier(.2,.7,.2,1) both; }
    @keyframes flowIn { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
    /* Hovering a photo dims the rest. */
    #flowField.is-hovering .flow-tile { opacity: .5; transition: opacity .45s ease-out; }
    #flowField.is-hovering .flow-tile.is-on { opacity: 1; transition: opacity .2s ease-out; }
    .flow-ph { position: relative; display: block; background: var(--flow-ph); }
    .flow-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
                   display: block; -webkit-user-drag: none; }
    .flow-cap { display: block; margin-top: 10px; font-family: "Inter Tight", system-ui, sans-serif;
                font-size: 11px; font-weight: 500; line-height: 1.25; letter-spacing: -.005em;
                color: var(--flow-cap); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
                transition: color .2s; }
    .flow-tile.is-on .flow-cap { color: var(--flow-cap-on); }
    /* Amber corner marks on the hovered / focused photo. */
    .flow-cn { position: absolute; width: 18px; height: 20px; border: 0 solid var(--flow-amber); opacity: 0;
               pointer-events: none; transition: opacity .3s, translate .3s cubic-bezier(.2,.7,.2,1); }
    .flow-cn.a { left: -4px; top: -4px; border-left-width: 2px; border-top-width: 2px; translate: 3px 3px; }
    .flow-cn.b { right: -4px; top: -4px; border-right-width: 2px; border-top-width: 2px; translate: -3px 3px; }
    .flow-cn.c { left: -4px; top: calc(var(--phh) - 16px); border-left-width: 2px; border-bottom-width: 2px; translate: 3px -3px; }
    .flow-cn.d { right: -4px; top: calc(var(--phh) - 16px); border-right-width: 2px; border-bottom-width: 2px; translate: -3px -3px; }
    .flow-tile.is-on .flow-cn, .flow-tile:focus-visible .flow-cn { opacity: 1; translate: 0 0; }
    .flow-tile:focus-visible { outline: none; }
    .flow-hint { position: fixed; z-index: 20; left: 24px; bottom: 30px; margin: 0; padding: 6px 10px;
                 border-radius: 99px; font-family: "Inter Tight", system-ui, sans-serif; font-size: 11px;
                 color: var(--flow-cap); background: var(--flow-chip); backdrop-filter: blur(6px);
                 pointer-events: none; transition: opacity .6s; }
    .flow-hint.is-gone { opacity: 0; }
    @media (max-width: 767px) { .flow-hint { display: none; } }
    .flow-empty { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
                  margin: 0; font-size: 15px; color: var(--flow-cap); pointer-events: none; }
    #flowView.hidden .flow-hint, #flowView.hidden .flow-empty { display: none; }
    .flow-noscript { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px;
                     list-style: none; margin: 0; padding: 96px 24px 120px; }
    .flow-noscript img { width: 100%; height: auto; display: block; }
    @media (prefers-reduced-motion: reduce) {
      .flow-tile.is-new { animation: none; }
    }

    /* Photos fade in once loaded (app.js adds .is-loaded); until then the
       tile shows the photo's dominant colour as its background. */
    .js .photo-img { opacity: 0; transition: opacity .4s ease; }
    .js .photo-img.is-loaded { opacity: 1; }
    .js .photo-img.no-fade { transition: none; }
    @media (prefers-reduced-motion: reduce) {
      .js .photo-img { transition: none; }
    }

    /* Shared "+" cursor over photos — one element, moved by app.js with a
       transform once per frame. */
    .photo-plus-cursor {
      position: fixed; left: 0; top: 0; z-index: 30;
      width: 58px; height: 58px;
      display: grid; place-items: center;
      pointer-events: none;
      opacity: 0; transition: opacity .15s ease;
      will-change: transform;
      color: #fff;
    }
    .photo-plus-cursor.is-visible { opacity: 1; }

    /* Grid's horizontal strip: swiping past its first or last photo on a
       touchpad made Chrome show its back/forward arrow and navigate
       (opening the last-visited photo). Keep the overscroll inside the
       strip, and turn off the page-level swipe while Grid is showing. */
    #gridStrip { overscroll-behavior-x: none; }
    html:has(#gridView:not(.hidden)),
    html:has(#gridView:not(.hidden)) body { overscroll-behavior-x: none; }
    /* Over a photo the "+" ring replaces the mouse pointer completely —
       including the hand on links and the zoom-in on the detail photo.
       Only for a real mouse; touch screens never show the ring. */
    @media (hover: hover) and (pointer: fine) {
      .js .photo-item, .js .photo-item * { cursor: none !important; }
    }
    .photo-plus-ring { position: absolute; inset: 0; width: 100%; height: 100%; }
    .photo-plus-icon { position: relative; width: 22px; height: 22px; }
  </style>
  <%# Apply the theme immediately to prevent a flash of the wrong one. Dark is the
      default; light only when the visitor picked it with the toggle. %>
  <script>
    (function(){
      document.documentElement.classList.add('js');
      var k = 'oww:theme';
      var saved = null;
      try { saved = localStorage.getItem(k); } catch (e) {}
      if (saved !== 'light') document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body class="bg-paper text-ink dark:bg-night dark:text-white font-sans">
