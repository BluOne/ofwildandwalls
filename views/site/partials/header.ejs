<%# views/partials/header.ejs — expects: view ('flow' | 'grid'), the tab that
should render as initially active/visible on page load %>
<%# Transparent: the photos show through. Its empty space lets clicks and
    drags through to the Flow wall; only its links/buttons take the pointer
    (see .site-header in head.ejs). %>
<header class="site-header fixed top-0 left-0 right-0 z-30 h-[74px] bg-transparent">
  <div class="relative h-full px-4 sm:px-6 md:px-9 flex items-center">
    <a
      href="https://www.instagram.com/ofwildandwalls/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="hdr-chip ml-auto md:ml-0"
    >
      <svg
        class="w-[20px] h-[20px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle
          cx="17.5"
          cy="6.5"
          r="0.8"
          fill="currentColor"
          stroke="none"
        ></circle>
      </svg>
    </a>

    <h1
      class="order-first md:order-none flex items-center h-full md:absolute md:left-1/2 md:-translate-x-1/2 md:justify-center"
    >
      <a href="/">
        <img
          src="/img/OfWild%26Walls.svg"
          alt="Of Wild &amp; Walls"
          class="h-[18px] md:h-[22px] w-auto dark:invert transition-transform hover:scale-105"
        />
      </a>
    </h1>

    <div class="ml-auto hidden md:flex items-center gap-2">
      <button
        type="button"
        class="js-theme-toggle hdr-chip"
        aria-label="Toggle dark mode"
      >
        <!-- Moon — visible in light mode -->
        <svg
          class="theme-icon-moon w-[20px] h-[20px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        >
          <path
            d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
          ></path>
        </svg>

        <!-- Sun — visible in dark mode -->
        <svg
          class="theme-icon-sun hidden w-[20px] h-[20px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.42 1.42"></path>
          <path d="m17.65 17.65 1.42 1.42"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m4.93 19.07 1.42-1.42"></path>
          <path d="m17.65 6.35 1.42-1.42"></path>
        </svg>
      </button>

      <%# Flow / Grid segmented toggle; app.js moves .is-active on switch. %>
      <div class="hdr-seg" role="group" aria-label="View">
        <button
          type="button"
          data-nav-view="flow"
          class="nav-link-desktop hdr-seg-btn<%= view === 'flow' ? ' is-active' : '' %>"
          aria-pressed="<%= view === 'flow' ? 'true' : 'false' %>"
        >Flow</button>
        <button
          type="button"
          data-nav-view="grid"
          class="nav-link-desktop hdr-seg-btn<%= view === 'grid' ? ' is-active' : '' %>"
          aria-pressed="<%= view === 'grid' ? 'true' : 'false' %>"
        >Grid</button>
      </div>
    </div>

    <%# Phones: no hamburger — the theme button and Flow/Grid toggle sit in the
        bottom bar next to Filters (see footer.ejs). %>
  </div>
</header>
