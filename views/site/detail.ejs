12.2787 6.33337H7.7029C6.50879 6.33337 6.50879 7.52748 6.50879 7.52748V9.13555C6.50879 10.3297 7.7029 10.3297 7.7029 10.3297H12.2787C13.4728 10.3297 13.4728 9.13555 13.4728 9.13555V7.52748C13.4728 6.33337 12.2787 6.33337 12.2787 6.33337Z\"></path></svg>"} }).replace(/</g, '\\u003c') %></script>

<div id="viewer" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <div class="vrail" id="vRail" aria-label="Photos"><div class="vtrack" id="vTrack"></div></div>
  <div class="vstage" id="vStage"></div>
  <aside class="vpanel" id="vPanel" aria-label="Photo details">
    <div class="vgrab" id="vGrab"></div>
    <div id="vDet"></div>
  </aside>
  <div class="vhint" id="vHint" aria-live="polite"></div>
  <div class="vtop">
    <button class="vcirc js-theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
      <svg class="theme-icon-sun hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button class="vdet" id="vDetTop" type="button" aria-pressed="false" aria-controls="vPanel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/></svg><span>Details</span>
    </button>
    <button class="vcirc" id="vClose" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
</div>

<script src="/js/app.js"></script>
<script src="/js/viewer.js"></script>
</body>
</html>
