<%# views/detail.ejs — photo viewer. The photo fills the stage; a thumbnail strip
    (left on desktop, bottom on phones) scrolls through the photos the visitor was
    browsing (filters carried over); Details slides a card in from the right.
    viewer.js runs it and keeps the URL on the photo shown. %>
<%- include('partials/head', { title: title }) %>

<style>
  :root { --v-paper: #ffffff; --v-ink: #141414; --v-ink-75: rgba(20,20,20,.75); --v-ink-55: rgba(20,20,20,.55);
          --v-ink-35: rgba(20,20,20,.35); --v-ink-15: rgba(20,20,20,.15); --v-hover: rgba(0,0,0,.04);
          --v-pill: #ffffff; --v-ctl: #f1f0ef; --v-ctl-hover: #e8e7e5; --v-shadow: 0 6px 28px rgba(0,0,0,.13);
          --v-ctl-shadow: 0 2px 10px rgba(0,0,0,.06); }
  .dark { --v-paper: #0d0d0d; --v-ink: #ffffff; --v-ink-75: rgba(255,255,255,.75); --v-ink-55: rgba(255,255,255,.55);
          --v-ink-35: rgba(255,255,255,.35); --v-ink-15: rgba(255,255,255,.15); --v-hover: rgba(255,255,255,.07);
          --v-pill: #1b1b1b; --v-ctl: #2a2a2a; --v-ctl-hover: #333333; --v-shadow: 0 6px 28px rgba(0,0,0,.6);
          --v-ctl-shadow: 0 4px 18px rgba(0,0,0,.35); }
  html, body { height: 100%; overflow: hidden; }
  #viewer { position: fixed; inset: 0; background: var(--v-paper); color: var(--v-ink); overflow: hidden;
            animation: vIn .3s ease-out; }
  @keyframes vIn { from { opacity: 0; } to { opacity: 1; } }
  #viewer button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  #viewer svg { display: block; }
  #viewer svg.hidden { display: none; } /* the inactive theme icon */

  /* stage: every photo has an <img>; switching is an instant visibility swap */
  .vstage { position: absolute; top: 64px; bottom: 64px; left: 170px; right: 170px; touch-action: none;
            transition: right .45s cubic-bezier(.2,.7,.2,1), bottom .45s cubic-bezier(.2,.7,.2,1),
                        top .45s cubic-bezier(.2,.7,.2,1), left .45s cubic-bezier(.2,.7,.2,1); }
  #viewer.det .vstage { right: calc(20px + 360px + 40px); }
  .vstage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: block;
                -webkit-user-drag: none; user-select: none; visibility: hidden; }
  .vstage img.on { visibility: visible; cursor: zoom-in; }
  #viewer.full .vstage img.on { cursor: zoom-out; }

  /* thumbnail strip: the thumb nearest the centre line is the photo shown; nearby thumbs ease outward */
  .vrail { position: absolute; z-index: 2; left: 0; top: 0; bottom: 0; width: 160px; overflow-y: auto; overflow-x: hidden;
           scrollbar-width: none; overscroll-behavior: contain;
           -webkit-mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
           mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent); }
  .vrail::-webkit-scrollbar { display: none; }
  .vtrack { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 50vh 0 50vh 20px; }
  .vrail button { flex: none; width: 80px; will-change: transform; }
  .vrail img { display: block; width: 100%; height: auto; opacity: .5; transition: opacity .25s; background: var(--v-hover); }
  .vrail button:hover img, .vrail button.on img { opacity: 1; }

  /* top-right controls: theme · Details · close */
  .vtop { position: absolute; z-index: 4; top: 16px; right: 20px; display: flex; gap: 8px; align-items: center; }
  .vcirc { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
           background: var(--v-ctl) !important; color: var(--v-ink); box-shadow: var(--v-ctl-shadow); transition: background-color .2s; }
  .vcirc:hover { background: var(--v-ctl-hover) !important; }
  .vcirc svg { width: 16px; height: 16px; }
  .vdet { display: flex; align-items: center; gap: 6px; white-space: nowrap; height: 34px; padding: 0 14px 0 11px !important;
          border-radius: 999px; background: var(--v-ctl) !important; box-shadow: var(--v-ctl-shadow); font-size: 13px;
          transition: background-color .2s, color .2s; }
  .vdet svg { width: 16px; height: 16px; }
  .vdet:hover { background: var(--v-ctl-hover) !important; }
  .vdet[aria-pressed="true"] { background: var(--v-ink) !important; color: var(--v-paper) !important; }

  /* details: floating card on desktop, bottom sheet on phones */
  .vpanel { position: absolute; z-index: 3; top: 64px; right: 20px; max-height: calc(100% - 128px); width: 360px;
            box-sizing: border-box; background: var(--v-pill); border-radius: 24px; box-shadow: var(--v-shadow);
            overflow-y: auto; scrollbar-width: none; padding: 26px 24px 24px; opacity: 0; transform: translateX(24px);
            pointer-events: none; transition: opacity .3s ease, transform .45s cubic-bezier(.2,.7,.2,1); }
  .vpanel::-webkit-scrollbar { display: none; }
  #viewer.det .vpanel { opacity: 1; transform: none; pointer-events: auto; }
  .vgrab { display: none; }
  .vpanel h2 { font-family: "Playfair Display", Georgia, serif; font-weight: 500; font-size: 28px; line-height: 1.1;
               margin: 0; letter-spacing: -.005em; text-wrap: balance; }
  .vref { font-size: 14px; color: var(--v-ink-55); margin-top: 8px; line-height: 1.4; }
  .vref i { font-family: "Playfair Display", Georgia, serif; font-style: italic; }
  .vabout { margin: 22px 0 0; font-size: 14.5px; line-height: 1.65; color: var(--v-ink-75); }
  .vrows { margin: 26px 0 0; border-top: 1px solid var(--v-ink-15); }
  .vrow { display: grid; grid-template-columns: 18px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--v-ink-15); align-items: start; }
  .vrow:last-child { border-bottom: 0; padding-bottom: 0; }
  .vrow dt { color: var(--v-ink-35); padding-top: 1px; }
  .vrow dt svg { width: 18px; height: 18px; }
  .vrow dd { margin: 0; font-size: 14px; line-height: 1.45; min-width: 0; }
  .vchips { display: flex; flex-wrap: wrap; gap: 6px; }
  .vchips span { padding: 4px 10px; border-radius: 999px; background: var(--v-hover); font-family: "Inter Tight", system-ui, sans-serif;
                 font-size: 12.5px; font-variant-numeric: tabular-nums; }

  /* full screen: click the photo; everything else steps away */
  #viewer.full .vstage { top: 16px; bottom: 16px; left: 16px; right: 16px; }
  .vrail, .vtop { transition: opacity .3s ease; }
  #viewer.full .vrail, #viewer.full .vtop { opacity: 0; pointer-events: none; }
  .vhint { position: absolute; z-index: 5; left: 50%; bottom: 24px; translate: -50% 8px; padding: 8px 14px; border-radius: 999px;
           background: color-mix(in srgb, var(--v-paper) 70%, transparent); backdrop-filter: blur(10px); font-size: 12px;
           color: var(--v-ink-75); white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .5s ease, translate .5s ease; }
  .vhint.on { opacity: 1; translate: -50% 0; }

  @media (max-width: 767px) {
    .vtop { top: auto; left: 50%; right: auto; translate: -50% 0; bottom: 16px; gap: 10px; }
    .vcirc { width: 44px; height: 44px; }
    .vcirc svg { width: 20px; height: 20px; }
    .vdet { height: 44px; padding: 0 22px 0 18px !important; font-size: 15px; gap: 8px; }
    .vdet svg { width: 19px; height: 19px; }
    .vstage { left: 16px; right: 16px; top: 16px; bottom: 178px; }
    #viewer.det .vstage { right: 16px; bottom: calc(62vh + 12px); }
    #viewer.det .vrail { opacity: 0; pointer-events: none; }
    #viewer.full .vstage { left: 0; right: 0; }
    .vrail { top: auto; left: 0; right: 0; bottom: 72px; width: auto; height: 80px; overflow-x: auto; overflow-y: hidden;
             overscroll-behavior: none; touch-action: pan-x;
             -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
             mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
    /* width: max-content so the right-hand 50vw padding counts towards the scroll
       range — otherwise with only a few photos the strip could barely scroll and
       the last thumbs never reached the centre. */
    .vtrack { flex-direction: row; align-items: flex-end; gap: 8px; height: 100%; box-sizing: border-box; padding: 0 50vw 10px;
              width: max-content; min-width: 100%; }
    .vrail button { width: auto; height: 54px; }
    .vrail img { height: 100%; width: auto; }
    .vpanel { top: auto; left: 8px; right: 8px; bottom: 72px; width: auto; max-height: none; height: calc(62vh - 72px);
              border-radius: 22px; transform: translateY(calc(100% + 90px)); opacity: 1; pointer-events: auto;
              box-shadow: 0 -10px 40px rgba(0,0,0,.3); padding: 10px 22px 24px; overscroll-behavior: contain; }
    .vgrab { display: block; width: 40px; height: 5px; border-radius: 3px; background: var(--v-ink-15); margin: 0 auto 18px; }
    .vpanel h2 { font-size: 24px; }
    #viewer.det .vpanel { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { #viewer { animation: none; } }
</style>

<%
  // Everything the viewer shows per photo (the rail holds the photos being browsed).
  var viewerPhotos = photos.map(function (p) {
    var d = p.details || {};
    return {
      // src/srcset: resized copies for the normal view; orig: the full-resolution upload, shown in full screen.
      slug: p.slug, alt: p.alt || d.title || '', src: p.srcLarge || p.src, srcset: p.srcset || '', orig: p.src, thumb: p.srcSmall || p.src,
      w: p.width || 0, h: p.height || 0, c: p.color || '',
      title: d.title || p.cap || '', ref: d.ref || '', about: d.about || '',
      location: d.locationLabel || '', date: d.dateLabel || '', camera: d.camera || '', lens: d.lens || '',
      settings: d.settings || '', category: d.categoryLabel || '', collections: d.collections || []
    };
  });
%>
<script id="viewerData" type="application/json"><%- JSON.stringify({ photos: viewerPhotos, current: photo.slug, filterQuery: filterQuery || '', icons: {"tags": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\"1.5\"/></svg>", "location": "<svg  viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 3c2.7 2.5 2.7 13.5 0 18M3 12h18M4.2 7h15.6M4.2 17h15.6\"></path></svg>", "date": "<svg  viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4.5\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M3 9.5h18M8 3v3M16 3v3\"></path></svg>", "camera": "<svg  viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.71\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15.6702 3.07715H8.3292L6.50724 6.37747C6.14686 6.40785 5.78855 6.43891 5.43243 6.46967C3.90966 6.60117 2.65614 7.77442 2.43303 9.28649C2.23092 10.6563 2.04883 12.0671 2.04883 13.5079C2.04883 14.9488 2.23092 16.3595 2.43303 17.7293C2.65614 19.2414 3.90966 20.4146 5.43243 20.5461C7.61725 20.735 9.805 20.923 11.9997 20.923C14.1944 20.923 16.3822 20.735 18.567 20.5461C20.0897 20.4146 21.3434 19.2414 21.5664 17.7293C21.7685 16.3595 21.9506 14.9488 21.9506 13.5079C21.9506 12.0671 21.7685 10.6563 21.5664 9.28649C21.3434 7.77442 20.0897 6.60117 18.567 6.46967C18.2088 6.43872 17.8505 6.40767 17.4921 6.37747L15.6702 3.07715Z\"></path><path d=\"M11.9993 16.6207C14.292 16.6207 15.5816 15.3311 15.5816 13.0384C15.5816 10.7457 14.292 9.45605 11.9993 9.45605C9.70663 9.45605 8.41699 10.7457 8.41699 13.0384C8.41699 15.3311 9.70663 16.6207 11.9993 16.6207Z\"></path></svg>", "lens": "<svg  viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.71\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 11.6976V11.4587\"></path><path d=\"M11.9997 21.0163C18.0403 21.0163 21.438 17.6187 21.438 11.5781C21.438 5.53753 18.0403 2.13831 11.9997 2.13831C5.95916 2.13831 2.56152 5.53753 2.56152 11.5781C2.56152 17.6187 5.95916 21.0163 11.9997 21.0163Z\"></path><path d=\"M3.48926 21.9383C3.72489 20.8078 4.37449 19.7554 5.35684 18.8845\"></path><path d=\"M20.5082 21.9382C20.2742 20.8078 19.6246 19.7554 18.6406 18.8845\"></path><path d=\"M11.9998 16.4373C15.1109 16.4373 16.8591 14.6876 16.8591 11.5781C16.8591 8.46708 15.1109 6.7189 11.9998 6.7189C8.89039 6.7189 7.14062 8.46708 7.14062 11.5781C7.14062 14.6876 8.89039 16.4373 11.9998 16.4373Z\"></path></svg>", "settings": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M14.3 3.3 9.5 11.6M20.3 9.2h-9.6M18.1 18.7 13.3 10.4M9.7 20.7l4.8-8.3M3.7 14.8h9.6M5.9 5.3l4.8 8.3\"/></svg>", "category": "<svg  viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.71\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22.3491 22.3489L19.5186 19.5186\"></path><path d=\"M7.06961 10.1144C6.69765 10.142 6.32141 10.1595 5.94151 10.1595C5.18696 10.1595 4.44689 10.0905 3.72609 10.0101C2.75568 9.90195 1.9748 9.12107 1.87093 8.15018C1.79425 7.43346 1.72949 6.69762 1.72949 5.94745C1.72949 5.19727 1.79425 4.46142 1.87093 3.74471C1.9748 2.77382 2.75568 1.99293 3.72609 1.88477C4.44689 1.80442 5.18696 1.73542 5.94151 1.73542C6.69606 1.73542 7.43615 1.80442 8.15695 1.88477C9.12736 1.99293 9.90824 2.77382 10.0121 3.74471C10.0888 4.46142 10.1535 5.19682 10.1535 5.94699C10.1535 6.30371 10.1389 6.65718 10.1153 7.00691\"></path><path d=\"M5.94151 13.8397C5.18696 13.8397 4.44689 13.9087 3.72609 13.989C2.75568 14.0972 1.9748 14.8